generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Availability {
  id          String  @id @default(cuid())
  teacherId   String
  dayOfWeek   Int
  shift       String  @default("MORNING")
  period      Int
  isAvailable Boolean @default(true)
  Teacher     Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, dayOfWeek, shift, period])
}

model Class {
  id                String              @id @default(cuid())
  name              String              @unique
  shift             String
  level             String
  regenteName       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @default(now())
  Curriculum        Curriculum[]
  FixedSubjectClass FixedSubjectClass[]
  Schedule          Schedule[]
}

model Curriculum {
  id             String   @id @default(cuid())
  classId        String
  subjectId      String
  teacherId      String?
  classesPerWeek Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())
  Teacher        Teacher? @relation(fields: [teacherId], references: [id])
  Subject        Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  Class          Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
}

model FixedSubjectClass {
  id                 String             @id @default(cuid())
  configId           String
  classId            String
  assignedPeriod     Int?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @default(now())
  Class              Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  FixedSubjectConfig FixedSubjectConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, classId])
}

model FixedSubjectConfig {
  id                String              @id @default(cuid())
  subjectId         String              @unique
  classesPerWeek    Int
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @default(now())
  FixedSubjectClass FixedSubjectClass[]
  Subject           Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

model Schedule {
  id        String   @id @default(cuid())
  classId   String
  subjectId String
  teacherId String?
  dayOfWeek Int
  period    Int
  isFixed   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  Teacher   Teacher? @relation(fields: [teacherId], references: [id])
  Subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  Class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, dayOfWeek, period])
}

model ScheduleTemplate {
  id                    String                  @id @default(cuid())
  name                  String
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @default(now())
  ScheduleTemplateEntry ScheduleTemplateEntry[]
}

model ScheduleTemplateEntry {
  id               String           @id @default(cuid())
  templateId       String
  className        String
  subjectName      String
  teacherName      String?
  dayOfWeek        Int
  period           Int
  isFixed          Boolean          @default(false)
  ScheduleTemplate ScheduleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model Subject {
  id                 String              @id @default(cuid())
  name               String              @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @default(now())
  Curriculum         Curriculum[]
  FixedSubjectConfig FixedSubjectConfig?
  Schedule           Schedule[]
}

model SubjectAlias {
  id         String   @id @default(cuid())
  sourceName String   @unique
  targetName String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())
}

model Teacher {
  id           String         @id @default(cuid())
  name         String         @unique
  type         String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now())
  Availability Availability[]
  Curriculum   Curriculum[]
  Schedule     Schedule[]
}

model TimeSlot {
  id        String @id @default(cuid())
  level     String
  shift     String
  dayOfWeek Int
  period    Int
  startTime String
  endTime   String

  @@unique([level, shift, dayOfWeek, period])
}
